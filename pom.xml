<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 https://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>

    <parent>
        <groupId>network.ike.platform</groupId>
        <artifactId>ike-parent</artifactId>
        <version>196</version>
        <relativePath/>
    </parent>

    <groupId>network.ike.komet</groupId>
    <artifactId>complex-clause-plugin</artifactId>
    <version>6-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Complex Clause Plugin</name>
    <description>
        Komet plugin for complex concept clauses: the Layer-2 / computable-logic criteria that
        exceed OWL EL++ expressivity (negation, disjunction, numeric comparison, counts, temporal
        relations). Clauses are stored as a second pattern on the concept (an expression tree of
        concepts mirroring HL7 ELM nodes), explicated to CQL that joins the inferred EL++ value set
        with the Layer-2 residual, and evaluated natively over the Tinkar/ANF substrate to
        met / not-met / indeterminate.
    </description>
    <url>https://ike.network/complex-clause-plugin/</url>
    <inceptionYear>2026</inceptionYear>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <organization>
        <name>IKE Network</name>
        <url>https://ike.network</url>
    </organization>

    <scm>
        <connection>scm:git:https://github.com/knowledge-graphlet/complex-clause-plugin.git</connection>
        <developerConnection>scm:git:git@github.com:knowledge-graphlet/complex-clause-plugin.git</developerConnection>
        <url>https://github.com/knowledge-graphlet/complex-clause-plugin</url>
        <tag>HEAD</tag>
    </scm>

    <!-- Required: ike-parent's enforcer fails an inheriting project whose effective site URL still
         starts with https://ike.network/ike-platform/ while its groupId is not network.ike.platform. -->
    <distributionManagement>
        <site>
            <id>ike-site</id>
            <url>https://ike.network/complex-clause-plugin/</url>
        </site>
    </distributionManagement>

    <!-- Snapshots of the IKE starter set resolve through here on a machine whose settings
         enable no snapshot repository, such as the test agent: a mirror's policy is the
         merge of the repositories a build declares (IkeKometWs_ReactorTest #157). The same
         block as rocks-kb, tinkar-service and komet carry; ike-parent is its durable home. -->
    <repositories>
        <repository>
            <id>tinkar-nexus</id>
            <url>https://nexus.tinkar.org/repository/ike-public/</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>true</enabled></snapshots>
        </repository>
    </repositories>

    <properties>
        <!-- Main-line Komet BOM; manages komet module + tinkar versions. Matches ike-komet-wsr. -->
        <komet-bom.version>3.0.12-SNAPSHOT</komet-bom.version>
        <!-- Tinkar version for the test-only datastore providers (not managed by komet-bom);
             must match the komet-bom-managed tinkar runtime so module-path service binding works. -->
        <tinkar.version>1.127.7-SNAPSHOT</tinkar.version>
        <!-- The IKE starter set the tests load, from starter-data-ws, which builds after this repository. -->
        <ike-starter-set.version>1-SNAPSHOT</ike-starter-set.version>
        <java.version>27</java.version>
        <!-- Lucene 10.5.1 turns its Vector API code on only up to Java 26 and warns on 27.
             The property raises that limit; the full suite passes with it. Drop it when
             a Lucene release supports Java 27. -->
        <argLine>--sun-misc-unsafe-memory-access=allow -Djava.util.logging.manager=org.apache.logging.log4j.jul.LogManager --add-modules jdk.incubator.vector -Dorg.apache.lucene.vectorization.upperJavaFeatureVersion=27</argLine>
        <!-- The nid build check (tinkar-core nid-check, IKE-Network/ike-issues#1244): how it
             reports (error, or warning for a census), which classes may narrow a nid, and
             javac's cap on warnings, high enough that no warning is dropped. -->
        <nid-check.report>error</nid-check.report>
        <nid-check.allow></nid-check.allow>
        <javac.maxwarns>10000</javac.maxwarns>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>dev.ikm.komet</groupId>
                <artifactId>komet-bom</artifactId>
                <version>3.0.12-SNAPSHOT</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Knowledge-layout SPI host: KlToolArea / KlSupplementalArea + SupplementalAreaBlueprint,
             KlArea, AreaGridSettings, KlPreferencesFactory. Version managed by komet-bom. -->
        <dependency>
            <groupId>dev.ikm.komet</groupId>
            <artifactId>knowledge-layout</artifactId>
        </dependency>

        <!-- Komet framework: ViewProperties + ViewCalculator (the journal view injected into the
             area; used for subsumption, descriptions, and the inferred axiom tree). -->
        <dependency>
            <groupId>dev.ikm.komet</groupId>
            <artifactId>framework</artifactId>
        </dependency>

        <!-- Tinkar entity: DiTreeEntity / EntityVertex (the clause graph substrate), calculators. -->
        <dependency>
            <groupId>dev.ikm.tinkar</groupId>
            <artifactId>entity</artifactId>
        </dependency>
        <!-- Tinkar common: PrimitiveData, EntityService, UuidT5Generator. -->
        <dependency>
            <groupId>dev.ikm.tinkar</groupId>
            <artifactId>common</artifactId>
        </dependency>

        <!-- JavaFX controls/layout for the tool area (tree view + CQL output + verdict badge). -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
        </dependency>

        <!-- Test: JUnit 5 + an ephemeral Tinkar datastore so the clause graph can assign nids and
             round-trip through a semantic. Versions managed by komet-bom. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.ikm.tinkar</groupId>
            <artifactId>data-spinedarray-provider</artifactId>
            <version>${tinkar.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.ikm.tinkar</groupId>
            <artifactId>entity-provider</artifactId>
            <version>${tinkar.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.ikm.tinkar</groupId>
            <artifactId>executor-provider</artifactId>
            <version>${tinkar.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- The shared test logging configuration (log4j2-test.xml); a library ships none of its own. -->
        <dependency>
            <groupId>dev.ikm.tinkar</groupId>
            <artifactId>test-logging</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-jul</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- The nid build check (tinkar-core nid-check, IKE-Network/ike-issues#1244). -->
                    <compilerArgs combine.children="append">
                        <arg>-Xplugin:NidCheck report=${nid-check.report} allow=${nid-check.allow}</arg>
                        <arg>-Xmaxwarns</arg>
                        <arg>${javac.maxwarns}</arg>
                        <arg>-Xmaxerrs</arg>
                        <arg>10000</arg>
                    </compilerArgs>
                    <annotationProcessorPathsUseDepMgmt>true</annotationProcessorPathsUseDepMgmt>
                    <annotationProcessorPaths combine.children="append">
                        <path>
                            <groupId>dev.ikm.tinkar</groupId>
                            <artifactId>nid-check</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <!-- Copy the IKE starter set into target/data so the store-backed tests that need a
                 view can load it into an ephemeral store (the same artifact and file name
                 komet/framework and komet-claude-plugin use:
                 target/data/ike-starter-set-reasoned-pb.zip). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-starter-data</id>
                        <phase>process-test-resources</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>network.ike.foundation</groupId>
                                    <artifactId>ike-starter-set</artifactId>
                                    <version>${ike-starter-set.version}</version>
                                    <classifier>reasoned-pb</classifier>
                                    <type>zip</type>
                                    <overWrite>false</overWrite>
                                    <outputDirectory>${project.build.directory}/data</outputDirectory>
                                    <destFileName>ike-starter-set-reasoned-pb.zip</destFileName>
                                </artifactItem>
                            </artifactItems>
                            <stripVersion>true</stripVersion>
                            <outputDirectory>${project.build.directory}/data</outputDirectory>
                            <overWriteReleases>false</overWriteReleases>
                            <!-- Copy only when the installed starter set is newer than the copy here, rather than
                                 overwriting it on every build. -->
                            <overWriteSnapshots>false</overWriteSnapshots>
                            <overWriteIfNewer>true</overWriteIfNewer>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
